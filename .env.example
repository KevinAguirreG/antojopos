# Copy to .env for local development. Never commit .env.

# --- Postgres: one engine, one database + role per service (technical-design §2) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Superuser: only for the init script and admin work, never for a service.
POSTGRES_PASSWORD=changeme
IDENTITY_DB_PASSWORD=changeme-identity
CATALOG_DB_PASSWORD=changeme-catalog
ORDERS_DB_PASSWORD=changeme-orders
PAYMENTS_DB_PASSWORD=changeme-payments
INVENTORY_DB_PASSWORD=changeme-inventory
REPORTING_DB_PASSWORD=changeme-reporting

# --- RabbitMQ ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=antojopos
RABBITMQ_PASSWORD=changeme
RABBITMQ_VHOST=antojopos

# --- Redis ---
REDIS_HOST=redis
REDIS_PASSWORD=changeme

# --- Used by the services from session 6 on ---
JWT_JWKS_URL=http://identity:8001/.well-known/jwks.json
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
